{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "shell",
      "command": "west build -p auto -b 'mimxrt1060_evk@B//qspi' -d crux-controller/build/s2 crux-controller/app -- -DCRUX_REQUIRE_VERIFIED_ZEPHYR=ON '-DEXTRA_CONF_FILE=conf/s1.conf;conf/s2.conf' '-DEXTRA_DTC_OVERLAY_FILE=boards/s2.overlay'",
      "options": { "cwd": "/workspaces/ws" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
