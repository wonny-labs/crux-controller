{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Board: Build",
      "type": "process",
      "command": "bash",
      "args": ["scripts/build-board.sh", "${input:configuration}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Board: Flash",
      "type": "process",
      "command": "west",
      "args": ["flash", "-d", "build/mimxrt1060_evk_B_qspi--current", "--runner", "jlink"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Board: Clean",
      "type": "process",
      "command": "bash",
      "args": ["scripts/build-board.sh", "--clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "clean",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "configuration",
      "type": "pickString",
      "description": "Build configuration of app/ to build for the RT1060-EVKB",
      "options": ["base", "workload", "net", "file", "system", "sntp", "management"],
      "default": "net"
    }
  ]
}
