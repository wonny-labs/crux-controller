{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build firmware",
      "type": "shell",
      "command": "west build -p auto -b 'mimxrt1060_evk@B//qspi' -d crux-controller/build/net crux-controller/app -- -DCRUX_REQUIRE_VERIFIED_ZEPHYR=ON '-DEXTRA_CONF_FILE=conf/workload.conf;conf/net.conf' '-DEXTRA_DTC_OVERLAY_FILE=boards/net.overlay'",
      "options": { "cwd": "/workspaces/ws" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Board: Build and flash",
      "type": "shell",
      "command": "west flash -d crux-controller/build/net --runner jlink",
      "dependsOn": ["Build firmware"],
      "options": { "cwd": "/workspaces/ws" },
      "problemMatcher": []
    }
  ]
}
