{
  "name": "Crux Controller (Ubuntu 24.04 amd64)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "options": ["--platform=linux/amd64"],
    "args": {
      "CRUX_JLINK": "auto",
      "CRUX_JLINK_DEB": "",
      "CRUX_JLINK_DEB_SHA256": "",
      "CRUX_JLINK_URL": "",
      "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
      "http_proxy": "${localEnv:http_proxy}",
      "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
      "https_proxy": "${localEnv:https_proxy}",
      "NO_PROXY": "${localEnv:NO_PROXY}",
      "no_proxy": "${localEnv:no_proxy}"
    }
  },
  "runArgs": [
    "--platform=linux/amd64",
    "--device-cgroup-rule=c 189:* rmw",
    "-v",
    "/dev/bus/usb:/dev/bus/usb"
  ],
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces/ws,type=bind",
  "workspaceFolder": "/workspaces/ws/crux-controller",
  "mounts": [
    "source=crux-controller-dev-cache-${devcontainerId},target=/opt/crux-cache,type=volume"
  ],
  "initializeCommand": "bash .devcontainer/check-host.sh",
  "containerEnv": {
    "CRUX_BOOTSTRAP": "${localEnv:CRUX_BOOTSTRAP:all}",
    "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
    "http_proxy": "${localEnv:http_proxy}",
    "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
    "https_proxy": "${localEnv:https_proxy}",
    "NO_PROXY": "${localEnv:NO_PROXY}",
    "no_proxy": "${localEnv:no_proxy}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash scripts/bootstrap.sh --keep-going",
  "postAttachCommand": "bash scripts/bootstrap.sh status",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "mcu-debug.debug-tracker-vscode",
        "mcu-debug.memory-view",
        "mcu-debug.rtos-views",
        "mcu-debug.peripheral-viewer",
        "marus25.cortex-debug",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/crux-cache/venv/bin/python"
      }
    }
  },
  "shutdownAction": "stopContainer"
}
