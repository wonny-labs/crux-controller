/* Step S4: the watchdog that Crux System owns on this board.
 *
 * The provider takes no watchdog by default: the composition names it with the alias
 * crux-watchdog0 and the provider checks that it is the RT1060's WDOG1 (wdog0, 0x400b8000) and that
 * it is enabled. The node is the one that the controller sample of crux-pilot selects. Used only
 * by the S4 image, through EXTRA_DTC_OVERLAY_FILE. It is configuration, not code.
 */
/ {
    aliases {
        crux-watchdog0 = &wdog0;
    };
};

&wdog0 {
    status = "okay";
};
