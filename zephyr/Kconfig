# The controller framework of this repository as a Zephyr module (zephyr/module.yml). One symbol
# turns it on; each service under it is on by default when the Crux and Zephyr symbols it needs
# are on, and a product leaves a service out by turning its symbol off. The services do not
# exclude each other.

menuconfig CRUX_CONTROLLER_FRAMEWORK
	bool "Controller framework"
	depends on CRUX_TIME && CRUX_LOGGING && MULTITHREADING
	help
	  Build the controller framework: controller_framework_start() in
	  <controller/framework.h>, which a product's main() calls once to start the Crux
	  services of a networked controller in a defined order, logging each phase through Crux
	  Logging. This version takes no application and creates no application thread. The
	  configurations of app/ that build on the workload (CRUX_CONTROLLER_WORKLOAD) do not combine
	  with it.

if CRUX_CONTROLLER_FRAMEWORK

config CRUX_CONTROLLER_FRAMEWORK_MANAGEMENT
	bool "Web management over HTTPS"
	default y
	depends on CRUX_ACCESS && CRUX_CONFIG_SERVICE && CRUX_MGMT_STATUS && CRUX_TLS_CERTIFICATE
	depends on CRUX_WEB_SESSION && CRUX_WEB_MANAGEMENT && CRUX_SYSTEM
	depends on FILE_SYSTEM && TLS_CREDENTIALS
	help
	  Mount the volume that the devicetree entry controller_storage describes, start the Crux
	  credential store, Access, the configuration service, the status service and the TLS
	  certificate, then sessions, web management and the HTTPS listener on
	  CONFIG_CRUX_WEB_BIND_ADDRESS (framework/compose/management_start.c). The image calls
	  controller_framework_image() from its CMakeLists.txt, which adds the route table and
	  the packaged page to its target app. The volume is formatted when it does not mount, which
	  suits only the RAM disk form, and the key and certificate are made at the first start.

config CRUX_CONTROLLER_FRAMEWORK_CLI_SERIAL
	bool "Serial command line"
	default y
	depends on CRUX_CONTROLLER_FRAMEWORK_MANAGEMENT && CRUX_CLI_CONSOLE
	help
	  Start the Crux serial console on the UART that the devicetree alias crux-serial0
	  names, after web management has started Access (framework/compose/cli_start.c). The
	  console prints a login prompt and nothing before it. With no account, the word !setup
	  at the prompt creates the first account, with the administrator role of the management
	  policy; once an account exists, setup is refused and every command needs a login. The
	  command line has the built-in commands of Crux (help, logout, passwd and account list)
	  and no command table of the framework yet. The console owns its UART: no Zephyr
	  console, log backend or shell may use it. SSH is not offered.

config CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC
	bool "Time synchronisation over SNTP"
	default y
	depends on SNTP && NET_UDP && NET_IPV4
	help
	  Query one SNTP server at a fixed interval from a low-priority thread and set the Crux Time
	  realtime clock through the Crux Time authority, with the policy of
	  framework/src/time_sync_policy.h. SNTP is unauthenticated. The server and the limits are the
	  options below.

# The options of time synchronisation. The configuration sntp of app/ defines the same symbols in
# app/Kconfig for its own option; the values and ranges are the same.

config CRUX_CONTROLLER_TIME_SERVER
	string "IPv4 address of the SNTP server"
	default "192.168.77.1"
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC
	help
	  An IPv4 address in dotted form, optionally followed by a colon and a port (123
	  otherwise). The image has no DNS resolver.

config CRUX_CONTROLLER_TIME_INTERVAL_S
	int "Seconds between two queries"
	default 600
	range 16 86400
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC

config CRUX_CONTROLLER_TIME_TIMEOUT_MS
	int "Milliseconds to wait for the answer to one query"
	default 3000
	range 100 30000
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC
	help
	  It must be shorter than the interval.

config CRUX_CONTROLLER_TIME_STALE_AGE_S
	int "Seconds after which an unconfirmed synchronised clock is marked not synchronised"
	default 1800
	range 60 604800
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC
	help
	  It must be longer than the interval.

config CRUX_CONTROLLER_TIME_THRESHOLD_MS
	int "Milliseconds below which a difference from a synchronised clock is left alone"
	default 100
	range 1 10000
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC
	help
	  It must not exceed the maximum step.

config CRUX_CONTROLLER_TIME_MAX_STEP_MS
	int "Milliseconds above which a difference from a synchronised clock is refused"
	default 1000
	range 1 3600000
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC

config CRUX_CONTROLLER_TIME_STACK
	int "Stack bytes of the time synchronisation thread"
	default 8192
	range 2048 65536
	depends on CRUX_CONTROLLER_FRAMEWORK_TIME_SYNC
	help
	  A starting value, not measured.

endif # CRUX_CONTROLLER_FRAMEWORK
