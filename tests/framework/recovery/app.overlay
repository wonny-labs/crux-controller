/* The devicetree of the base scenario (tests/framework/base/app.overlay), with a retained region
 * over the test-only retained memory of ../common, which keeps its bytes across a restart of the
 * simulated process, as boards/retained.overlay places the region for the board.
 *
 * From the devicetree of the management scenario (tests/native_sim_mbed/management/app.overlay):
 * Crux Logging writes to an emulated UART here, so that the test can read what it wrote. The RAM
 * disk and the fstab entry are the ones that boards/management.overlay declares for the board, with the
 * same names, because the composition zone looks up the entry controller_storage. The disk is
 * blank at every start: the zone formats it. The Crux serial console owns a second emulated UART
 * through the alias crux-serial0: the test types into its receive side and reads its transmit
 * side. */
/ {
    aliases { crux-serial0 = &serial_test; };
    chosen { zephyr,log-uart = &logging_uarts; };
    logging_uarts: logging-uarts {
        compatible = "zephyr,log-uart";
        uarts = <&logging_test>;
    };
    logging_test: logging-test {
        compatible = "zephyr,uart-emul";
        current-speed = <115200>;
        rx-fifo-size = <16>;
        tx-fifo-size = <16384>;
        status = "okay";
    };
    serial_test: serial-test {
        compatible = "zephyr,uart-emul";
        current-speed = <115200>;
        rx-fifo-size = <1024>;
        tx-fifo-size = <1024>;
        status = "okay";
    };

    retained_env: retained-env {
        compatible = "vnd,retained-env";
        size = <256>;
        status = "okay";
        #address-cells = <1>;
        #size-cells = <1>;

        controller_retained: retention@0 {
            compatible = "zephyr,retention";
            status = "okay";
            reg = <0x0 0x30>;
            prefix = [43 52 43 31];
            checksum = <4>;
        };
    };

    ramdisk0 {
        compatible = "zephyr,ram-disk";
        disk-name = "RAM";
        sector-size = <512>;
        sector-count = <1024>;
    };

    fstab {
        compatible = "zephyr,fstab";
        controller_storage: controller-storage {
            compatible = "zephyr,fstab,fatfs";
            mount-point = "/RAM:";
            disk-access;
        };
    };
};
