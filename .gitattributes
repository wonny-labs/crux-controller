# Line endings. The dev container scripts run under Linux bash and break on CRLF, so they are
# checked out with LF on every platform. The default eol=lf also holds with core.autocrlf=false, where
# the default core.eol=native would give CRLF on Windows.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
.devcontainer/** text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
Kconfig text eol=lf
*.conf text eol=lf
*.overlay text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
