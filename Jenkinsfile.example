// SPDX-License-Identifier: Apache-2.0
// Example only. Jenkins does not run this file: a pipeline job reads a file named Jenkinsfile.
// For a copy of this repository that Jenkins builds from Bitbucket Cloud. Put it in its own scheduled
// Pipeline job on main, not in the CI pipeline of the repository's `Jenkinsfile`, and replace each
// <placeholder>. It does what .github/workflows/crux-pin-update.yml does: once a day it runs
// crux-pin-bot.py of the Crux that west.yml pins (never a script from Crux main), which moves the pin
// and opens or refreshes one pull request on bot/crux-pin. It never merges.
// The guard below runs it only on main, never for a pull request or for bot/crux-pin, which pins a
// Crux nobody has reviewed yet. In a single-branch Pipeline job BRANCH_NAME is unset and the guard
// never matches: use when { expression { env.BRANCH_NAME == null || env.BRANCH_NAME == 'main' } } there.
// Known gap: the Jenkins path has no evidence step yet; the step 3 evidence is GitHub only.
// The Crux scripts and their interface are those of the pinned Crux.
//
// The last stage holds the push and pull request credentials, so nothing that an earlier run or
// another job left behind may reach it:
// - The job runs on an agent label of its own, which no pull request build uses: those builds run
//   an unreviewed Crux and could leave files or processes behind.
// - Each run empties its workspace and WORKSPACE_TMP first and checks out again. The venv and the
//   copies of the three Crux scripts go to a fresh WORKSPACE_TMP/crux-pin. The venv holds only the
//   hashed packages of scripts/crux-pin-requirements.txt. The scripts are read with git show from
//   the pinned revision, after checking that the Crux checkout is at that revision and has no
//   changed, untracked or ignored file. Replace refs are ignored when the scripts are copied.
// - Each stage that runs code has its own container of the dev container image, on the same node
//   and workspace, removed when the stage ends, so no process of the fetch stage outlives it.
// Before going live, check on the agent:
// - Docker Pipeline with stage-level dockerfile agents on a Linux node, one container per stage.
// - No container gets the docker socket, --pid=host, --ipc=host or --privileged, and the agent is
//   not itself a container whose volumes reach the stages through --volumes-from.
// - Each container has a container-local /tmp, not a mounted one.
// - The containers run as the uid that owns the workspace, so that deleteDir and Git work.
// - The Docker Pipeline plugin does not put the values of the bound credentials on the host's
//   docker exec command line; if it does, hide other users' processes on the host (hidepid=2).
// What the Crux bot still leaves to this file: it gives the hook every variable except the token's,
// so the hook and every Git process the bot starts receive GIT_USERNAME and GIT_PASSWORD (the push
// credential) and GIT_ASKPASS from gitUsernamePassword while the hook runs. That is accepted only
// because the hook is this repository's reviewed script and runs nothing else; Crux's
// docs/product-composition.md ("Keeping the token from the build") asks for its two-stage
// crux-pin-stage.py instead when a hook builds. The same page says that a Jenkins checkout over
// HTTPS needs --push-url with the product's own URL; check that before going live.

pipeline {
  agent none
  triggers { cron('H 4 * * *') }
  options {
    disableConcurrentBuilds()
    skipDefaultCheckout()
    timeout(time: 20, unit: 'MINUTES')
  }
  environment {
    BITBUCKET_REPOSITORY = '<workspace>/<repository>'
  }
  stages {
    stage('Crux pin') {
      when { beforeAgent true; allOf { branch 'main'; not { changeRequest() } } }
      agent { label '<agent label of this job only, not shared with pull request builds>' }
      stages {
        stage('Start clean') {
          steps {
            deleteDir()
            dir(env.WORKSPACE_TMP) { deleteDir() }
            // A checkout in a subfolder: west makes the folder above the manifest its workspace.
            dir('crux-controller') { checkout scm }
          }
        }
        stage('Fetch the pinned Crux') {
          agent {
            dockerfile {
              dir 'crux-controller/.devcontainer'
              filename 'Dockerfile'
              additionalBuildArgs '--platform=linux/amd64'
              reuseNode true
            }
          }
          steps {
            // West needs read access to the Crux remote of west.yml, for example a Git credential helper.
            sh '''
              set -eu
              T="$WORKSPACE_TMP/crux-pin"
              mkdir -p "$T/scripts"
              python3 -m venv "$T/venv"
              # docopt is published only as source: it is built with the hashed setuptools installed
              # first, without build isolation, so pip fetches no unhashed build tool.
              "$T/venv/bin/pip" install -q --require-hashes -r crux-controller/scripts/crux-pin-build-requirements.txt
              "$T/venv/bin/pip" install -q --require-hashes --no-build-isolation --only-binary :all: --no-binary docopt -r crux-controller/scripts/crux-pin-requirements.txt
              "$T/venv/bin/west" init -l crux-controller
              "$T/venv/bin/west" update crux
              export GIT_NO_REPLACE_OBJECTS=1
              rev="$("$T/venv/bin/west" list -f '{revision}' crux)"
              case "$rev" in
                *[!0-9a-f]*|'') echo "The pin is not a full commit SHA: $rev" >&2; exit 1 ;;
              esac
              test "${#rev}" -eq 40 || { echo "The pin is not a full commit SHA: $rev" >&2; exit 1; }
              test "$(git -C crux rev-parse HEAD)" = "$rev"
              status="$(git -C crux status --porcelain --ignored)"
              test -z "$status"
              git -C crux cat-file -e "$rev:scripts/crux-pin-bot.py" 2>/dev/null || {
                echo "The pinned Crux has no scripts/crux-pin-bot.py. Move the pin by hand once (CONTRIBUTING.md)." >&2
                exit 1
              }
              for script in crux-pin-bot.py update-crux-pin.py open-pin-pr.py; do
                git -C crux show "$rev:scripts/$script" > "$T/scripts/$script"
              done
            '''
          }
        }
        stage('Move the pin and refresh the pull request') {
          agent {
            dockerfile {
              dir 'crux-controller/.devcontainer'
              filename 'Dockerfile'
              additionalBuildArgs '--platform=linux/amd64'
              reuseNode true
            }
          }
          steps {
            // CRUX_PIN_TOKEN: a Bitbucket Cloud access token with pull request write access, for the
            // pull request only: the bot never gives the token to Git. It pushes its branch with plain
            // Git, which takes its credentials from gitUsernamePassword. It commits only the allowed
            // paths (west.yml and what scripts/crux-pin-hook edits) and fails on any other
            // change in the checkout, so review.md is written outside it. Single quotes: the shell,
            // not Groovy, expands the credentials. Only reviewed code holds the credentials here: the
            // copies of the pinned Crux scripts and scripts/crux-pin-hook, which runs no build.
            // Run no build in this stage; the pull request builds of the new pin run without these
            // credentials.
            withCredentials([string(credentialsId: '<Jenkins token credentials ID>', variable: 'CRUX_PIN_TOKEN'),
                             gitUsernamePassword(credentialsId: '<Jenkins Git credentials ID>', gitToolName: 'Default')]) {
              dir('crux-controller') {
                sh '''
                  set -eu
                  T="$WORKSPACE_TMP/crux-pin"
                  "$T/venv/bin/python" scripts/pin_evidence.py body > "$T/review.md"
                  "$T/venv/bin/python" "$T/scripts/crux-pin-bot.py" --host bitbucket-cloud \
                    --repo "$BITBUCKET_REPOSITORY" --manifest west.yml --project crux \
                    --base main --branch bot/crux-pin --token-env CRUX_PIN_TOKEN --append-body "$T/review.md" \
                    --allow-path west.yml \
                    --allow-path tests/tooling/test_manifest.py \
                    --allow-path docs/dependencies.md \
                    --allow-path RELEASE.md \
                    --allow-path tests/tooling/test_docs.py \
                    --allow-path CHANGELOG.md \
                    --allow-path README.md \
                    --allow-path docs/findings/README.md \
                    --allow-path docs/adding-a-capability.md \
                    --allow-path docs/architecture.md \
                    --allow-path docs/board-bring-up.md \
                    --allow-path docs/documentation-guidelines.md \
                    --allow-path tests/tooling/test_docs_navigation.py \
                    --allow-path tests/tooling/test_management.py \
                    --allow-path tests/tooling/test_sntp.py \
                    --allow-path tests/tooling/test_system.py
                '''
              }
            }
          }
        }
      }
    }
  }
}
